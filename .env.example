# ===========================================================================
# CallNotes AI - environment configuration (development defaults)
# Copy this file to `.env` and adjust for your machine. NEVER commit `.env`.
# ===========================================================================

# --- General ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Backend ---------------------------------------------------------------
PORT=8787
# Comma-separated list of allowed browser origins (admin app / desktop dev).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Public base URL used in generated links / OpenAPI servers.
PUBLIC_API_URL=http://localhost:8787
# Host the API listens on. 127.0.0.1 keeps it local; use 0.0.0.0 to expose.
HOST=127.0.0.1

# --- PostgreSQL ------------------------------------------------------------
# Default matches the docker-compose.yml deployment.
DATABASE_URL=postgresql://callnotes:callnotes@localhost:55432/callnotes?schema=public
# Boot embedded PostgreSQL automatically when running `npm run dev`. Set 0 to
# use an external database (e.g. `docker compose up -d postgres`).
EMBEDDED_PG=1
# DEV_* used by scripts/dev-db.mjs when running an embedded PostgreSQL (no Docker).
DEV_PG_PORT=55432
DEV_PG_USER=callnotes
DEV_PG_PASSWORD=callnotes
DEV_PG_DATABASE=callnotes
DEV_PG_DATA_DIR=./data/pg

# --- Development seed users (never production credentials) ------------------
SEED_ADMIN_EMAIL=admin@callnotes.local
SEED_ADMIN_PASSWORD=change-me
SEED_DEMO_EMAIL=demo@callnotes.local
SEED_DEMO_PASSWORD=change-me

# --- Authentication session cookie ------------------------------------------
# 32+ chars; signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=
SESSION_TTL_DAYS=14
# Keep false in local dev (no HTTPS); must be true behind HTTPS.
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# --- Corporate/proxied networks only ---------------------------------------
# Some networks intercept TLS. Node trusts the OS certificate store when this
# flag is active, which fixes downloads (Prisma engines, Electron, models).
# NODE_OPTIONS=--use-system-ca